<?xml version="1.0" encoding="utf-8"?>
<!--
  Local AI Model Manager - offline-first build.

  The application deliberately depends ONLY on framework references
  (Microsoft.NETCore.App, Microsoft.WindowsDesktop.App, Microsoft.AspNetCore.App).
  No third-party NuGet package is used anywhere, so all remote package sources are
  cleared: restore is fully offline and deterministic.
-->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
</configuration>
