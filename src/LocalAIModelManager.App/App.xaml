<Application x:Class="LocalAIModelManager.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:LocalAIModelManager.App.Infrastructure"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <conv:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <conv:BytesToHumanConverter x:Key="BytesToHumanConverter" />
            <conv:DurationToHumanConverter x:Key="DurationToHumanConverter" />
            <conv:DateTimeToLocalConverter x:Key="DateTimeToLocalConverter" />
            <conv:ModelStateToBrushConverter x:Key="ModelStateToBrushConverter" />
            <conv:BoolToTextConverter x:Key="BoolToTextConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
