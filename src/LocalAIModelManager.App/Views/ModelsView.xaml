<UserControl x:Class="LocalAIModelManager.App.Views.ModelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LocalAIModelManager.App.Infrastructure"
             xmlns:conv="clr-namespace:LocalAIModelManager.App.Infrastructure"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="720" d:DesignWidth="1200">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:EmptyStringToVisibilityConverter x:Key="EmptyToVisibility" />
        <conv:BytesToHumanConverter x:Key="BytesToHuman" />
        <conv:DurationToHumanConverter x:Key="DurationToHuman" />
        <conv:ModelStateToBrushConverter x:Key="StateToBrush" />
    </UserControl.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Muted}" Margin="0,6,0,0" MaxWidth="1100" />
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <Button Content="{loc:T models.toolbar.add}" Style="{StaticResource Button.Primary}" Command="{Binding AddCommand}" />
            <Button Content="{loc:T models.toolbar.edit}" Command="{Binding EditCommand}" />
            <Button Content="{loc:T models.toolbar.rename}" Command="{Binding RenameCommand}" />
            <Button Content="{loc:T models.toolbar.start}" Command="{Binding StartCommand}" />
            <Button Content="{loc:T models.toolbar.stop}" Command="{Binding StopCommand}" />
            <Button Content="{loc:T models.toolbar.restart}" Command="{Binding RestartCommand}" />
            <Button Content="{loc:T models.toolbar.test}" Command="{Binding TestCommand}" />
            <Button Content="{loc:T models.toolbar.autotune}" Style="{StaticResource Button.Primary}" Command="{Binding AutoTuneCommand}"
                    ToolTip="{loc:T models.toolbar.autotuneTip}" />
            <Button Content="{loc:T models.toolbar.autotuneAll}" Command="{Binding AutoTuneAllCommand}"
                    ToolTip="{loc:T models.toolbar.autotuneAllTip}" />
            <Button Content="{loc:T models.toolbar.unloadAll}" Command="{Binding UnloadAllCommand}" />
            <Button Content="{loc:T models.toolbar.copyId}" Command="{Binding CopyIdCommand}" />
            <Button Content="{loc:T models.toolbar.openFolder}" Command="{Binding OpenFolderCommand}" />
            <Button Content="{loc:T models.toolbar.refresh}" Command="{Binding RefreshCommand}" />
            <Button Content="{loc:T models.toolbar.delete}" Style="{StaticResource Button.Danger}" Command="{Binding DeleteCommand}" />
        </WrapPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="350" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" ItemsSource="{Binding Models}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                      Margin="0,0,14,0">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{loc:T models.column.state}" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource Status.Dot}"
                                             Fill="{Binding State, Converter={StaticResource StateToBrush}}" />
                                    <TextBlock Text="{Binding StateLabel}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{loc:T models.column.id}" Binding="{Binding Id}" Width="180" />
                    <DataGridTextColumn Header="{loc:T models.column.displayName}" Binding="{Binding DisplayName}" Width="180" />
                    <DataGridTextColumn Header="{loc:T models.column.engine}" Binding="{Binding EngineName}" Width="160" />
                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70" />
                    <DataGridTextColumn Header="{loc:T models.column.port}" Binding="{Binding Port}" Width="70" />
                    <DataGridTextColumn Header="{loc:T models.column.activeRequests}" Binding="{Binding ActiveRequests}" Width="70" />
                    <DataGridTextColumn Header="{loc:T models.column.totalRequests}" Binding="{Binding TotalRequests}" Width="80" />
                    <DataGridTemplateColumn Header="{loc:T models.column.vram}" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding VramBytes, Converter={StaticResource BytesToHuman}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{loc:T models.column.idleFor}" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding IdleFor, Converter={StaticResource DurationToHuman}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{loc:T models.column.lastStop}" Binding="{Binding LastStopLabel}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{loc:T models.details.header}" Style="{StaticResource Text.SectionTitle}" />
                    <TextBlock Text="{Binding SelectedDetails}" Style="{StaticResource KeyValue.Value}"
                               FontSize="12" />
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,14,0,0"
                Visibility="{Binding TestOutput, Converter={StaticResource EmptyToVisibility}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{loc:T models.output.header}" Style="{StaticResource Text.SectionTitle}" />
                <TextBox Text="{Binding TestOutput, Mode=OneWay}" Style="{StaticResource CodeBlock}" Height="150" />
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource Status.Ready}"
                       Visibility="{Binding StatusMessage, Converter={StaticResource EmptyToVisibility}}" />
            <TextBlock Style="{StaticResource Text.Muted}" FontSize="11" Margin="0,4,0,0"
                       Text="{loc:T models.footer.hint}" />
        </StackPanel>
    </Grid>
</UserControl>
