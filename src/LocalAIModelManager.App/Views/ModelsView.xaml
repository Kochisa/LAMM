<UserControl x:Class="LocalAIModelManager.App.Views.ModelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:LocalAIModelManager.App.Infrastructure"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="720" d:DesignWidth="1200">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:EmptyStringToVisibilityConverter x:Key="EmptyToVisibility" />
        <conv:BytesToHumanConverter x:Key="BytesToHuman" />
        <conv:DurationToHumanConverter x:Key="DurationToHuman" />
        <conv:ModelStateToBrushConverter x:Key="StateToBrush" />
    </UserControl.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Muted}" Margin="0,6,0,0" MaxWidth="1100" />
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <Button Content="添加模型…" Style="{StaticResource Button.Primary}" Command="{Binding AddCommand}" />
            <Button Content="编辑…" Command="{Binding EditCommand}" />
            <Button Content="重命名…" Command="{Binding RenameCommand}" />
            <Button Content="启动" Command="{Binding StartCommand}" />
            <Button Content="停止" Command="{Binding StopCommand}" />
            <Button Content="重启" Command="{Binding RestartCommand}" />
            <Button Content="测试" Command="{Binding TestCommand}" />
            <Button Content="卸载全部" Command="{Binding UnloadAllCommand}" />
            <Button Content="复制 ID" Command="{Binding CopyIdCommand}" />
            <Button Content="打开所在目录" Command="{Binding OpenFolderCommand}" />
            <Button Content="刷新" Command="{Binding RefreshCommand}" />
            <Button Content="删除" Style="{StaticResource Button.Danger}" Command="{Binding DeleteCommand}" />
        </WrapPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="350" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" ItemsSource="{Binding Models}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                      Margin="0,0,14,0">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="状态" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource Status.Dot}"
                                             Fill="{Binding State, Converter={StaticResource StateToBrush}}" />
                                    <TextBlock Text="{Binding StateLabel}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="模型 ID" Binding="{Binding Id}" Width="180" />
                    <DataGridTextColumn Header="显示名称" Binding="{Binding DisplayName}" Width="180" />
                    <DataGridTextColumn Header="引擎" Binding="{Binding EngineName}" Width="160" />
                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70" />
                    <DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="70" />
                    <DataGridTextColumn Header="请求中" Binding="{Binding ActiveRequests}" Width="70" />
                    <DataGridTextColumn Header="累计请求" Binding="{Binding TotalRequests}" Width="80" />
                    <DataGridTemplateColumn Header="显存" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding VramBytes, Converter={StaticResource BytesToHuman}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="空闲时长" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding IdleFor, Converter={StaticResource DurationToHuman}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="最近停止" Binding="{Binding LastStopLabel}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="选中模型详情" Style="{StaticResource Text.SectionTitle}" />
                    <TextBlock Text="{Binding SelectedDetails}" Style="{StaticResource KeyValue.Value}"
                               FontSize="12" />
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,14,0,0"
                Visibility="{Binding TestOutput, Converter={StaticResource EmptyToVisibility}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="测试输出" Style="{StaticResource Text.SectionTitle}" />
                <TextBox Text="{Binding TestOutput, Mode=OneWay}" Style="{StaticResource CodeBlock}" Height="150" />
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource Status.Ready}"
                       Visibility="{Binding StatusMessage, Converter={StaticResource EmptyToVisibility}}" />
            <TextBlock Style="{StaticResource Text.Muted}" FontSize="11" Margin="0,4,0,0"
                       Text="删除模型条目不会删除模型文件。所有模型在管理器启动时都保持待机。" />
        </StackPanel>
    </Grid>
</UserControl>
