<UserControl x:Class="LocalAIModelManager.App.Views.RuntimeLogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LocalAIModelManager.App.Infrastructure"
             xmlns:conv="clr-namespace:LocalAIModelManager.App.Infrastructure"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="720" d:DesignWidth="1250">

    <UserControl.Resources>
        <conv:EmptyStringToVisibilityConverter x:Key="EmptyToVisibility" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Muted}" Margin="0,6,0,0" MaxWidth="1100" />
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBox Width="240" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                     ToolTip="{loc:T logs.toolbar.searchHint}" />
            <TextBlock Text="{loc:T logs.toolbar.level}" Style="{StaticResource KeyValue.Label}" Margin="12,0,8,0" />
            <ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding MinimumLevel, Mode=TwoWay}" Width="130" />
            <CheckBox Content="{loc:T logs.toolbar.autoScroll}" IsChecked="{Binding AutoScroll, Mode=TwoWay}" Margin="12,0,12,0" />
            <Button Content="{loc:T logs.toolbar.pause}" Command="{Binding TogglePauseCommand}"
                    Visibility="{Binding LoggingPaused, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
            <Button Content="{loc:T logs.toolbar.resume}" Command="{Binding TogglePauseCommand}"
                    Visibility="{Binding LoggingPaused, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="{loc:T common.search}" Command="{Binding SearchCommand}" />
            <Button Content="{loc:T logs.toolbar.clear}" Style="{StaticResource Button.Danger}" Command="{Binding ClearCommand}" />
            <Button Content="{loc:T logs.toolbar.copy}" Command="{Binding CopyCommand}" />
            <Button Content="{loc:T logs.toolbar.save}" Style="{StaticResource Button.Primary}" Command="{Binding SaveCommand}" />
        </WrapPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6">
            <DataGrid x:Name="LogGrid" ItemsSource="{Binding Entries}" IsReadOnly="True" RowHeight="22"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:T logs.column.time}" Binding="{Binding Time}" Width="100" />
                    <DataGridTextColumn Header="{loc:T logs.column.level}" Binding="{Binding Level}" Width="90" />
                    <DataGridTextColumn Header="{loc:T logs.column.category}" Binding="{Binding Category}" Width="150" />
                    <DataGridTextColumn Header="{loc:T logs.column.message}" Binding="{Binding Message}" Width="*" />
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Foreground" Value="{DynamicResource App.Foreground}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Tone}" Value="error">
                                <Setter Property="Foreground" Value="{DynamicResource Status.Error}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tone}" Value="warn">
                                <Setter Property="Foreground" Value="{DynamicResource Status.Busy}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tone}" Value="muted">
                                <Setter Property="Foreground" Value="{DynamicResource App.ForegroundMuted}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="{Binding Statistics}" Style="{StaticResource Text.Muted}" FontSize="11" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource Status.Ready}" Margin="0,4,0,0"
                       Visibility="{Binding StatusMessage, Converter={StaticResource EmptyToVisibility}}" />
            <TextBlock Style="{StaticResource Text.Muted}" FontSize="11" Margin="0,4,0,0"
                       Text="{loc:T logs.footer}" />
        </StackPanel>
    </Grid>
</UserControl>
