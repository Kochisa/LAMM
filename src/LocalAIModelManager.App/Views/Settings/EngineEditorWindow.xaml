<Window x:Class="LocalAIModelManager.App.Views.Settings.EngineEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LocalAIModelManager.App.Infrastructure"
        Title="{loc:T page.settingsEngine.title}"
        Width="680"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource App.Background}">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:T editor.engine.id}" Style="{StaticResource KeyValue.Label}" Margin="0,8,12,8" />
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="IdBox" Margin="0,4,0,4" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:T editor.engine.name}" Style="{StaticResource KeyValue.Label}" Margin="0,8,12,8" />
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="NameBox" Margin="0,4,0,4" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:T editor.engine.adapter}" Style="{StaticResource KeyValue.Label}" Margin="0,8,12,8" />
        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="AdapterBox" HorizontalAlignment="Left" Margin="0,4,0,4">
            <ComboBoxItem Content="llamacpp" Tag="llamacpp" />
            <ComboBoxItem Content="openai-compatible" Tag="openai-compatible" />
        </ComboBox>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:T editor.engine.executable}" Style="{StaticResource KeyValue.Label}" Margin="0,8,12,8" />
        <Grid Grid.Row="3" Grid.Column="1" Margin="0,4,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="ExecutableBox" />
            <Button Grid.Column="1" Content="{loc:T common.browse}" Margin="8,0,0,0" Click="OnBrowseExecutable" />
        </Grid>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:T editor.engine.workingDir}" Style="{StaticResource KeyValue.Label}" Margin="0,8,12,8" />
        <Grid Grid.Row="4" Grid.Column="1" Margin="0,4,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="WorkingDirectoryBox" />
            <Button Grid.Column="1" Content="{loc:T common.browse}" Margin="8,0,0,0" Click="OnBrowseWorkingDirectory" />
        </Grid>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:T editor.engine.startupTimeout}" Style="{StaticResource KeyValue.Label}" Margin="0,8,12,8" />
        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,4">
            <TextBox x:Name="StartupTimeoutBox" Width="90" />
            <TextBlock Text="{loc:T editor.engine.seconds}" Style="{StaticResource Text.Muted}" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="{loc:T editor.engine.extraArgs}" Style="{StaticResource KeyValue.Label}" Margin="0,8,12,8"
                   VerticalAlignment="Top" />
        <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,4,0,4">
            <TextBox x:Name="ExtraArgumentsBox" AcceptsReturn="True" Height="90"
                     VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" />
            <TextBlock Text="{loc:T editor.engine.extraArgsHint}" Style="{StaticResource Text.Muted}"
                       FontSize="11" Margin="0,4,0,0" />
        </StackPanel>

        <TextBlock Grid.Row="7" Grid.Column="1" x:Name="ErrorText" Foreground="{DynamicResource Status.Error}"
                   TextWrapping="Wrap" Margin="0,10,0,0" />

        <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{loc:T common.cancel}" Width="90" IsCancel="True" Click="OnCancel" />
            <Button Content="{loc:T common.ok}" Width="90" Style="{StaticResource Button.Primary}" Click="OnConfirm" />
        </StackPanel>
    </Grid>
</Window>
