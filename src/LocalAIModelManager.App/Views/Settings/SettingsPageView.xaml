<UserControl x:Class="LocalAIModelManager.App.Views.Settings.SettingsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LocalAIModelManager.App.Infrastructure"
             xmlns:conv="clr-namespace:LocalAIModelManager.App.Infrastructure"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="700" d:DesignWidth="900">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:EmptyStringToVisibilityConverter x:Key="EmptyToVisibility" />
    </UserControl.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Muted}"
                       Margin="0,6,0,0" MaxWidth="900" HorizontalAlignment="Left" />
        </StackPanel>

        <!-- Fields -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Fields}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource App.Border}"
                                    Padding="0,10,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource App.Foreground}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Help}" Style="{StaticResource Text.Muted}"
                                                   FontSize="11" Margin="0,3,0,0"
                                                   Visibility="{Binding Help, Converter={StaticResource EmptyToVisibility}}" />
                                        <TextBlock Text="{loc:T general.value.enforced}" FontSize="11" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource Status.Busy}"
                                                   Visibility="{Binding IsEditable, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                        <TextBlock Text="{Binding ValidationError}" FontSize="11" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource Status.Error}"
                                                   Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- boolean -->
                                        <CheckBox IsChecked="{Binding BoolValue, Mode=TwoWay}"
                                                  Visibility="{Binding IsBool, Converter={StaticResource BoolToVisibility}}" />

                                        <!-- choice -->
                                        <ComboBox ItemsSource="{Binding Choices}"
                                                  SelectedItem="{Binding SelectionValue, Mode=TwoWay}"
                                                  Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisibility}}" />

                                        <!-- plain text / number -->
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding IsPlainInput, Converter={StaticResource BoolToVisibility}}">
                                            <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     MinWidth="320" IsEnabled="{Binding IsEditable}" />
                                            <TextBlock Text="{Binding Suffix}" Style="{StaticResource Text.Muted}"
                                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                                            <Button Content="{loc:T common.browse}" Margin="8,0,0,0"
                                                    Command="{Binding BrowseCommand}"
                                                    Visibility="{Binding ShowBrowse, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>

                                        <!-- read only -->
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding Value}" Style="{StaticResource KeyValue.Value}" />
                                            <Button Content="{loc:T common.copy}" Margin="10,0,0,0" Command="{Binding CopyCommand}" />
                                        </StackPanel>

                                        <!-- secret -->
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding ShowSecretMasked, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding DisplayValue}" FontFamily="Cascadia Mono, Consolas"
                                                           VerticalAlignment="Center" Foreground="{DynamicResource App.Foreground}" />
                                            </StackPanel>
                                            <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     MinWidth="320" FontFamily="Cascadia Mono, Consolas"
                                                     Visibility="{Binding ShowSecretEditor, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Content="{loc:T api.button.reveal}" Margin="8,0,0,0"
                                                    Command="{Binding ToggleRevealCommand}"
                                                    Visibility="{Binding ShowSecretMasked, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Content="{loc:T settings.secret.hide}" Margin="8,0,0,0"
                                                    Command="{Binding ToggleRevealCommand}"
                                                    Visibility="{Binding ShowSecretEditor, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Content="{loc:T settings.secret.generate}" Margin="8,0,0,0"
                                                    Command="{Binding GenerateKeyCommand}"
                                                    Visibility="{Binding ShowGenerate, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Content="{loc:T common.copy}" Margin="8,0,0,0"
                                                    Command="{Binding CopyCommand}"
                                                    Visibility="{Binding ShowCopy, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Notes + actions -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <ItemsControl ItemsSource="{Binding Notes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource Text.Muted}" FontSize="11" Margin="0,2,0,0" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding StatusMessage}" Margin="0,6,0,0"
                           Visibility="{Binding StatusMessage, Converter={StaticResource EmptyToVisibility}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Status.Ready}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Status.Error}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="{loc:T common.reload}" Command="{Binding ReloadCommand}" />
                <Button Content="{loc:T common.save}" Style="{StaticResource Button.Primary}" Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsNotBusy}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
