<UserControl x:Class="LocalAIModelManager.App.Views.Settings.InferenceEngineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LocalAIModelManager.App.Infrastructure"
             xmlns:conv="clr-namespace:LocalAIModelManager.App.Infrastructure"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:EmptyStringToVisibilityConverter x:Key="EmptyToVisibility" />
    </UserControl.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Muted}" Margin="0,6,0,0" MaxWidth="980" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="{loc:T engine.toolbar.add}" Style="{StaticResource Button.Primary}" Command="{Binding AddCommand}" />
                        <Button Content="{loc:T engine.toolbar.edit}" Command="{Binding EditCommand}" />
                        <Button Content="{loc:T engine.toolbar.probe}" Command="{Binding ProbeCommand}" />
                        <Button Content="{loc:T engine.toolbar.use}" Command="{Binding UseCommand}" />
                        <Button Content="{loc:T engine.toolbar.remove}" Style="{StaticResource Button.Danger}" Command="{Binding RemoveCommand}" />
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding Engines}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:T engine.column.isDefault}" Binding="{Binding IsSelected}" Width="60" />
                            <DataGridTextColumn Header="{loc:T engine.column.id}" Binding="{Binding Id}" Width="150" />
                            <DataGridTextColumn Header="{loc:T engine.column.name}" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="{loc:T engine.column.adapter}" Binding="{Binding AdapterKind}" Width="130" />
                            <DataGridTextColumn Header="{loc:T engine.column.version}" Binding="{Binding Version}" Width="120" />
                            <DataGridTextColumn Header="{loc:T engine.column.paramCount}" Binding="{Binding ParameterCount}" Width="80" />
                            <DataGridTextColumn Header="{loc:T engine.column.modelCount}" Binding="{Binding ModelCount}" Width="80" />
                            <DataGridTextColumn Header="{loc:T engine.column.status}" Binding="{Binding Status}" Width="180" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{loc:T engine.selected.header}" Style="{StaticResource Text.SectionTitle}" />

                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="{Binding Selected.ExecutablePath}" Style="{StaticResource KeyValue.Value}"
                                   FontSize="11" FontFamily="Cascadia Mono, Consolas" />
                        <TextBlock Text="{Binding ProbeSummary}" Style="{StaticResource Text.Muted}" Margin="0,6,0,0" />
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Top" Text="{loc:T engine.supported.header}"
                               Style="{StaticResource Text.SectionTitle}" />
                    <ListBox ItemsSource="{Binding SupportedParameters}" FontFamily="Cascadia Mono, Consolas"
                             FontSize="11" />
                </DockPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource Status.Ready}"
                       Visibility="{Binding StatusMessage, Converter={StaticResource EmptyToVisibility}}" />
            <TextBlock Style="{StaticResource Text.Muted}" FontSize="11" Margin="0,6,0,0"
                       Text="{loc:T engine.footer.upgrade}" />
            <TextBlock Style="{StaticResource Text.Muted}" FontSize="11" Margin="0,2,0,0"
                       Text="{loc:T engine.footer.delete}" />
        </StackPanel>
    </Grid>
</UserControl>
