<UserControl x:Class="LocalAIModelManager.App.Views.Settings.InferenceEngineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:LocalAIModelManager.App.Infrastructure"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:EmptyStringToVisibilityConverter x:Key="EmptyToVisibility" />
    </UserControl.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Muted}" Margin="0,6,0,0" MaxWidth="980" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="添加引擎…" Style="{StaticResource Button.Primary}" Command="{Binding AddCommand}" />
                        <Button Content="编辑…" Command="{Binding EditCommand}" />
                        <Button Content="重新探测" Command="{Binding ProbeCommand}" />
                        <Button Content="设为默认" Command="{Binding UseCommand}" />
                        <Button Content="删除" Style="{StaticResource Button.Danger}" Command="{Binding RemoveCommand}" />
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding Engines}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="默认" Binding="{Binding IsSelected}" Width="60" />
                            <DataGridTextColumn Header="引擎 ID" Binding="{Binding Id}" Width="150" />
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="适配器" Binding="{Binding AdapterKind}" Width="130" />
                            <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="120" />
                            <DataGridTextColumn Header="参数数" Binding="{Binding ParameterCount}" Width="80" />
                            <DataGridTextColumn Header="模型数" Binding="{Binding ModelCount}" Width="80" />
                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="180" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="所选引擎" Style="{StaticResource Text.SectionTitle}" />

                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="{Binding Selected.ExecutablePath}" Style="{StaticResource KeyValue.Value}"
                                   FontSize="11" FontFamily="Cascadia Mono, Consolas" />
                        <TextBlock Text="{Binding ProbeSummary}" Style="{StaticResource Text.Muted}" Margin="0,6,0,0" />
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Top" Text="该引擎支持的参数（来自 --help）"
                               Style="{StaticResource Text.SectionTitle}" />
                    <ListBox ItemsSource="{Binding SupportedParameters}" FontFamily="Cascadia Mono, Consolas"
                             FontSize="11" />
                </DockPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource Status.Ready}"
                       Visibility="{Binding StatusMessage, Converter={StaticResource EmptyToVisibility}}" />
            <TextBlock Style="{StaticResource Text.Muted}" FontSize="11" Margin="0,6,0,0"
                       Text="引擎升级：把新的 llama-server.exe 放到任意目录，添加为新的引擎记录并对模型切换即可；旧引擎可随时删除。" />
            <TextBlock Style="{StaticResource Text.Muted}" FontSize="11" Margin="0,2,0,0"
                       Text="删除引擎只移除注册信息，绝不会删除任何磁盘文件。" />
        </StackPanel>
    </Grid>
</UserControl>
