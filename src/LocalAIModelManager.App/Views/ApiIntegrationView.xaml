<UserControl x:Class="LocalAIModelManager.App.Views.ApiIntegrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LocalAIModelManager.App.Infrastructure"
             xmlns:conv="clr-namespace:LocalAIModelManager.App.Infrastructure"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="760" d:DesignWidth="1250">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:EmptyStringToVisibilityConverter x:Key="EmptyToVisibility" />
    </UserControl.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Muted}" Margin="0,6,0,0" MaxWidth="1100" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- connection info -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{loc:T api.connection.header}" Style="{StaticResource Text.SectionTitle}" />

                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Base URL" Style="{StaticResource KeyValue.Label}" />
                            <TextBox Grid.Column="1" Text="{Binding BaseUrl, Mode=OneWay}" IsReadOnly="True"
                                     FontFamily="Cascadia Mono, Consolas" />
                            <Button Grid.Column="2" Content="{loc:T api.button.copy}" Margin="8,0,0,0" Command="{Binding CopyBaseUrlCommand}" />
                        </Grid>

                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="API Key" Style="{StaticResource KeyValue.Label}" />
                            <TextBox Grid.Column="1" Text="{Binding ApiKeyDisplay, Mode=OneWay}" IsReadOnly="True"
                                     FontFamily="Cascadia Mono, Consolas" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="{loc:T api.button.show}" Command="{Binding ToggleRevealCommand}" />
                                <Button Content="{loc:T api.button.copy}" Command="{Binding CopyApiKeyCommand}" />
                                <Button Content="{loc:T api.button.regenerate}" Command="{Binding RegenerateKeyCommand}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T api.row.modelId}" Style="{StaticResource KeyValue.Label}" />
                            <ComboBox Grid.Column="1" HorizontalAlignment="Left" MinWidth="260"
                                      ItemsSource="{Binding ModelIds}" SelectedItem="{Binding SelectedModelId, Mode=TwoWay}" />
                            <Button Grid.Column="2" Content="{loc:T api.button.copy}" Command="{Binding CopyModelIdCommand}" />
                        </Grid>

                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T api.row.gatewayState}" Style="{StaticResource KeyValue.Label}" />
                            <TextBlock Grid.Column="1" Text="{Binding GatewayStateText}" Style="{StaticResource KeyValue.Value}" />
                        </Grid>

                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T api.row.exposure}" Style="{StaticResource KeyValue.Label}" />
                            <TextBlock Grid.Column="1" Text="{Binding BindingText}" Style="{StaticResource KeyValue.Value}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2,0,2"
                                               Foreground="{DynamicResource Status.Busy}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- endpoints -->
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{loc:T api.endpoints.header}" Style="{StaticResource Text.SectionTitle}" />
                        <DataGrid ItemsSource="{Binding Endpoints}" MaxHeight="220">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:T api.column.method}" Binding="{Binding Method}" Width="70" />
                                <DataGridTextColumn Header="{loc:T api.column.path}" Binding="{Binding Path}" Width="260" />
                                <DataGridTextColumn Header="{loc:T api.column.description}" Binding="{Binding Description}" Width="*" />
                                <DataGridTextColumn Header="{loc:T api.column.auth}" Binding="{Binding Auth}" Width="240" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- python (openai sdk) -->
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{loc:T api.section.python}" Style="{StaticResource Text.SectionTitle}" />
                        <Button DockPanel.Dock="Top" Content="{loc:T api.copy.python}" HorizontalAlignment="Left"
                                Margin="0,0,0,8" Command="{Binding CopyPythonCommand}" />
                        <TextBox Text="{Binding PythonExample, Mode=OneWay}" Style="{StaticResource CodeBlock}" Height="300" />
                    </DockPanel>
                </Border>

                <!-- python raw -->
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{loc:T api.section.pythonRaw}" Style="{StaticResource Text.SectionTitle}" />
                        <Button DockPanel.Dock="Top" Content="{loc:T api.copy.pythonRaw}" HorizontalAlignment="Left"
                                Margin="0,0,0,8" Command="{Binding CopyPythonRawCommand}" />
                        <TextBox Text="{Binding PythonRawExample, Mode=OneWay}" Style="{StaticResource CodeBlock}" Height="280" />
                    </DockPanel>
                </Border>

                <!-- curl -->
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{loc:T api.section.curl}" Style="{StaticResource Text.SectionTitle}" />
                        <Button DockPanel.Dock="Top" Content="{loc:T api.copy.curl}" HorizontalAlignment="Left"
                                Margin="0,0,0,8" Command="{Binding CopyCurlCommand}" />
                        <TextBox Text="{Binding CurlExample, Mode=OneWay}" Style="{StaticResource CodeBlock}" Height="180" />
                    </DockPanel>
                </Border>

                <!-- powershell -->
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{loc:T api.section.powershell}" Style="{StaticResource Text.SectionTitle}" />
                        <Button DockPanel.Dock="Top" Content="{loc:T api.copy.powershell}" HorizontalAlignment="Left"
                                Margin="0,0,0,8" Command="{Binding CopyPowerShellCommand}" />
                        <TextBox Text="{Binding PowerShellExample, Mode=OneWay}" Style="{StaticResource CodeBlock}" Height="240" />
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource Status.Ready}"
                       Visibility="{Binding StatusMessage, Converter={StaticResource EmptyToVisibility}}" />
            <TextBlock Style="{StaticResource Text.Muted}" FontSize="11" Margin="0,4,0,0"
                       Text="{loc:T api.footer}" />
        </StackPanel>
    </Grid>
</UserControl>
