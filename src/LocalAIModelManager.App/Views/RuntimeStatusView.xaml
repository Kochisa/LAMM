<UserControl x:Class="LocalAIModelManager.App.Views.RuntimeStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LocalAIModelManager.App.Infrastructure"
             xmlns:conv="clr-namespace:LocalAIModelManager.App.Infrastructure"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="760" d:DesignWidth="1250">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:EmptyStringToVisibilityConverter x:Key="EmptyToVisibility" />
        <conv:BytesToHumanConverter x:Key="BytesToHuman" />
        <conv:DurationToHumanConverter x:Key="DurationToHuman" />
        <conv:ModelStateToBrushConverter x:Key="StateToBrush" />
        <conv:DateTimeToLocalConverter x:Key="DateTimeLocal" />
    </UserControl.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Muted}" Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="{loc:T status.toolbar.refresh}" Command="{Binding RefreshCommand}" />
            <Button Content="{loc:T status.toolbar.copyJson}" Command="{Binding CopyJsonCommand}" />
            <Button Content="{loc:T status.toolbar.unloadAll}" Command="{Binding UnloadAllCommand}" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- gateway + resources -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,14">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{loc:T status.gateway.header}" Style="{StaticResource Text.SectionTitle}" />
                            <ItemsControl ItemsSource="{Binding GatewayRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource KeyValue.Label}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Value}" Style="{StaticResource KeyValue.Value}" />
                                                <TextBlock Text="{Binding Hint}" FontSize="11"
                                                           Foreground="{DynamicResource App.ForegroundMuted}"
                                                           Visibility="{Binding Hint, Converter={StaticResource EmptyToVisibility}}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,14">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{loc:T status.resources.header}" Style="{StaticResource Text.SectionTitle}" />

                            <StackPanel DockPanel.Dock="Top" Margin="0,10,0,10">
                                <TextBlock Text="{loc:T status.value.vramUsage}" Style="{StaticResource KeyValue.Label}" />
                                <ProgressBar Height="18" Minimum="0" Maximum="100" Value="{Binding GpuUsedPercent, Mode=OneWay}"
                                             Foreground="{DynamicResource App.Accent}"
                                             Background="{DynamicResource App.SurfaceAlt}"
                                             BorderBrush="{DynamicResource App.Border}" />
                                <TextBlock Text="{Binding GpuUsedText}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="{loc:T status.value.cpuUsage}" Style="{StaticResource KeyValue.Label}" />
                                <ProgressBar Height="18" Minimum="0" Maximum="100" Value="{Binding CpuPercent, Mode=OneWay}"
                                             Foreground="{DynamicResource App.Accent}"
                                             Background="{DynamicResource App.SurfaceAlt}"
                                             BorderBrush="{DynamicResource App.Border}" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding ResourceRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource KeyValue.Label}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource KeyValue.Value}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- models -->
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{loc:T status.models.header}" Style="{StaticResource Text.SectionTitle}" />
                        <DataGrid ItemsSource="{Binding Models}" MaxHeight="240">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{loc:T models.column.state}" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Style="{StaticResource Status.Dot}"
                                                         Fill="{Binding State, Converter={StaticResource StateToBrush}}" />
                                                <TextBlock Text="{Binding StateLabel}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{loc:T models.column.id}" Binding="{Binding Id}" Width="170" />
                                <DataGridTextColumn Header="{loc:T models.column.engine}" Binding="{Binding EngineName}" Width="150" />
                                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70" />
                                <DataGridTextColumn Header="{loc:T status.column.internalPort}" Binding="{Binding Port}" Width="80" />
                                <DataGridTextColumn Header="{loc:T models.column.activeRequests}" Binding="{Binding ActiveRequests}" Width="70" />
                                <DataGridTextColumn Header="{loc:T models.column.totalRequests}" Binding="{Binding TotalRequests}" Width="80" />
                                <DataGridTemplateColumn Header="{loc:T models.column.vram}" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding VramBytes, Converter={StaticResource BytesToHuman}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{loc:T status.column.lastUsed}" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding LastUsedAtUtc, Converter={StaticResource DateTimeLocal}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{loc:T models.column.idleFor}" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding IdleFor, Converter={StaticResource DurationToHuman}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- processes -->
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{loc:T status.processes.header}" Style="{StaticResource Text.SectionTitle}" />
                        <DataGrid ItemsSource="{Binding Processes}" MaxHeight="200" Margin="0,0,0,14">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80" />
                                <DataGridTextColumn Header="{loc:T status.column.model}" Binding="{Binding ModelId}" Width="160" />
                                <DataGridTextColumn Header="{loc:T models.column.engine}" Binding="{Binding EngineId}" Width="150" />
                                <DataGridTextColumn Header="{loc:T status.column.internalPort}" Binding="{Binding Port}" Width="90" />
                                <DataGridTextColumn Header="{loc:T models.column.state}" Binding="{Binding State}" Width="100" />
                                <DataGridTextColumn Header="{loc:T status.column.alive}" Binding="{Binding IsAlive}" Width="70" />
                                <DataGridTemplateColumn Header="{loc:T status.column.startedAt}" Width="170">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StartedAtUtc, Converter={StaticResource DateTimeLocal}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{loc:T status.column.workingSet}" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding WorkingSetBytes, Converter={StaticResource BytesToHuman}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock DockPanel.Dock="Top" Text="{loc:T status.exited.header}" Style="{StaticResource Text.SectionTitle}" />
                        <DataGrid ItemsSource="{Binding ExitedProcesses}" MaxHeight="160">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80" />
                                <DataGridTextColumn Header="{loc:T status.column.model}" Binding="{Binding ModelId}" Width="160" />
                                <DataGridTextColumn Header="{loc:T status.column.exitCode}" Binding="{Binding ExitCode}" Width="80" />
                                <DataGridTextColumn Header="{loc:T status.column.stopMode}" Binding="{Binding StopMode}" Width="110" />
                                <DataGridTemplateColumn Header="{loc:T status.column.exitedAt}" Width="170">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ExitedAtUtc, Converter={StaticResource DateTimeLocal}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- engines -->
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{loc:T status.engines.header}" Style="{StaticResource Text.SectionTitle}" />
                        <DataGrid ItemsSource="{Binding Engines}" MaxHeight="220">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:T status.column.engineId}" Binding="{Binding Id}" Width="140" />
                                <DataGridTextColumn Header="{loc:T status.column.name}" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="{loc:T status.column.adapter}" Binding="{Binding AdapterKind}" Width="130" />
                                <DataGridTextColumn Header="{loc:T status.column.version}" Binding="{Binding Version}" Width="120" />
                                <DataGridTextColumn Header="{loc:T status.column.paramCount}" Binding="{Binding SupportedParameterCount}" Width="80" />
                                <DataGridTextColumn Header="{loc:T status.column.modelCount}" Binding="{Binding ModelCount}" Width="80" />
                                <DataGridTextColumn Header="{loc:T status.column.isDefault}" Binding="{Binding IsSelected}" Width="60" />
                                <DataGridTextColumn Header="{loc:T status.column.gpuDevices}" Binding="{Binding GpuDevicesText}" Width="320" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- issues -->
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{loc:T status.issues.header}" Style="{StaticResource Text.SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding Issues}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,2,0,2"
                                               Foreground="{DynamicResource Status.Busy}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{loc:T status.issues.none}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Issues.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Margin="0,10,0,0"
                   Foreground="{DynamicResource Status.Ready}"
                   Visibility="{Binding StatusMessage, Converter={StaticResource EmptyToVisibility}}" />
    </Grid>
</UserControl>
