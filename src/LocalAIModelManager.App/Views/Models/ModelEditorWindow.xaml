<Window x:Class="LocalAIModelManager.App.Views.Models.ModelEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:LocalAIModelManager.App.Infrastructure"
        Title="模型"
        Width="880"
        Height="720"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource App.Background}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- identity -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="模型 ID" Style="{StaticResource KeyValue.Label}" Margin="0,8,12,8" />
            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,4,12,4">
                <TextBox x:Name="IdBox" />
                <TextBlock x:Name="IsNewInfo" Text="ID 是 API 中的 model 字段，创建后不可修改"
                           Style="{StaticResource Text.Muted}" FontSize="11" Margin="0,3,0,0" />
            </StackPanel>

            <TextBlock Grid.Row="0" Grid.Column="2" Text="显示名称" Style="{StaticResource KeyValue.Label}" Margin="0,8,12,8" />
            <TextBox Grid.Row="0" Grid.Column="3" x:Name="DisplayNameBox" Margin="0,4,0,4" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="模型文件" Style="{StaticResource KeyValue.Label}" Margin="0,8,12,8" />
            <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,4,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="FilePathBox" />
                <Button Grid.Column="1" Content="浏览…" Margin="8,0,0,0" Click="OnBrowseExecutable" />
            </Grid>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="推理引擎" Style="{StaticResource KeyValue.Label}" Margin="0,8,12,8" />
            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="EngineBox" ItemsSource="{Binding EngineOptions}"
                      DisplayMemberPath="Display" Margin="0,4,12,4"
                      SelectionChanged="OnEngineChanged" />

            <CheckBox Grid.Row="2" Grid.Column="3" x:Name="EnabledBox" Content="启用该模型" Margin="0,4,0,4" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="备注" Style="{StaticResource KeyValue.Label}" Margin="0,8,12,8" />
            <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" x:Name="NotesBox" Margin="0,4,0,4" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,14,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           Text="模型参数（未勾选 = 不下发；导入的模型默认为空，不套用任何推理参数）"
                           Style="{StaticResource Text.SectionTitle}" Margin="0" />
                <Button Grid.Column="1" x:Name="AutoTuneButton" Content="按显存自动计算"
                        Margin="0" Click="OnAutoTune"
                        ToolTip="显式操作：读取 GGUF 元数据并结合显存给出建议值，填入下面的字段供你确认" />
            </Grid>
            <TextBlock x:Name="AutoTuneSummary" Style="{StaticResource Text.Muted}"
                       FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
            <TextBlock x:Name="GlobalHint" Style="{StaticResource Text.Muted}"
                       FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource App.Border}"
                                                    Padding="0,6,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="280" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                              IsEnabled="{Binding Supported}" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                                        <TextBlock Text="{Binding DisplayName}" />
                                                        <TextBlock FontSize="11" Foreground="{DynamicResource App.ForegroundMuted}">
                                                            <Run Text="{Binding Key, Mode=OneWay}" />
                                                            <Run Text="  ·  " />
                                                            <Run Text="{Binding SupportLabel, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <CheckBox IsChecked="{Binding BoolValue, Mode=TwoWay}" IsEnabled="{Binding IsEditable}"
                                                                  Visibility="{Binding IsBoolean, Converter={StaticResource BoolToVisibility}}" />
                                                        <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectionValue, Mode=TwoWay}"
                                                                  IsEnabled="{Binding IsEditable}"
                                                                  Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisibility}}" />
                                                        <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 MinWidth="220" IsEnabled="{Binding IsEditable}"
                                                                 Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Margin="0,14,0,4">
                    <TextBlock Text="其他参数（高级，一行一个 llama.cpp 参数）"
                               Style="{StaticResource Text.SectionTitle}" />
                    <TextBox Text="{Binding AdditionalArgumentsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Height="80" AcceptsReturn="True" TextWrapping="NoWrap"
                             FontFamily="Cascadia Mono, Consolas" />
                    <TextBlock Style="{StaticResource Text.Muted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="示例：--some-option value ／ --another-option。按原样追加到命令行；--model / --host / --port 由管理器托管。" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="3" x:Name="ErrorText" Foreground="{DynamicResource Status.Error}"
                   TextWrapping="Wrap" Margin="0,8,0,0" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" Width="90" IsCancel="True" Click="OnCancel" />
            <Button Content="确定" Width="90" Style="{StaticResource Button.Primary}" Click="OnConfirm" />
        </StackPanel>
    </Grid>
</Window>
