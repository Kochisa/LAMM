<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light theme palette (same keys as the dark theme) -->
    <SolidColorBrush x:Key="App.Background" Color="#F4F5F8" />
    <SolidColorBrush x:Key="App.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="App.SurfaceAlt" Color="#EDEFF4" />
    <SolidColorBrush x:Key="App.Border" Color="#D5D9E2" />
    <SolidColorBrush x:Key="App.Foreground" Color="#1B1E27" />
    <SolidColorBrush x:Key="App.ForegroundMuted" Color="#616779" />
    <SolidColorBrush x:Key="App.Accent" Color="#1E6BE0" />
    <SolidColorBrush x:Key="App.AccentForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="App.Hover" Color="#E3E7EF" />
    <SolidColorBrush x:Key="App.InputBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="App.Selection" Color="#D6E4FF" />

    <SolidColorBrush x:Key="Status.Ready" Color="#1F9D63" />
    <SolidColorBrush x:Key="Status.Busy" Color="#C98A11" />
    <SolidColorBrush x:Key="Status.Error" Color="#CF3448" />
    <SolidColorBrush x:Key="Status.Idle" Color="#8A90A0" />

</ResourceDictionary>
