<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== shared control styles ===================== -->

    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource App.Foreground}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Text.Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource App.ForegroundMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Text.PageTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource App.Foreground}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Text.SectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource App.Foreground}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource App.Foreground}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{DynamicResource App.Foreground}" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource App.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource App.SurfaceAlt}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Foreground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource App.Hover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource App.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource App.AccentForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Accent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{DynamicResource Status.Error}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Status.Error}" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource App.InputBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Foreground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="CaretBrush" Value="{DynamicResource App.Foreground}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource App.Accent}" />
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{DynamicResource App.InputBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Foreground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,4" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource App.Foreground}" />
        <Setter Property="Margin" Value="0,4,0,4" />
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource App.Foreground}" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource App.InputBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Foreground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="MinWidth" Value="160" />
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="{DynamicResource App.InputBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Foreground}" />
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource App.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Foreground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource App.Foreground}" />
        <Setter Property="Padding" Value="8,6" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource App.Selection}" />
                <Setter Property="Foreground" Value="{DynamicResource App.Foreground}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource App.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Foreground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="RowBackground" Value="{DynamicResource App.Surface}" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource App.SurfaceAlt}" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource App.Border}" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="RowHeight" Value="30" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource App.SurfaceAlt}" />
        <Setter Property="Foreground" Value="{DynamicResource App.ForegroundMuted}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource App.Foreground}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="{DynamicResource App.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Foreground}" />
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{DynamicResource App.Foreground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
        <Setter Property="Margin" Value="0,0,0,14" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource App.Border}" />
        <Setter Property="Margin" Value="0,10,0,10" />
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource App.SurfaceAlt}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Foreground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
    </Style>

    <Style x:Key="Status.Dot" TargetType="Ellipse">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <Style x:Key="KeyValue.Label" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource App.ForegroundMuted}" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="KeyValue.Value" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource App.Foreground}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="CodeBlock" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="Background" Value="{DynamicResource App.InputBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Foreground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
    </Style>

</ResourceDictionary>
