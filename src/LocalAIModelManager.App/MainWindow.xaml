<Window x:Class="LocalAIModelManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Local AI Model Manager"
        Height="820" Width="1320" MinHeight="620" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource App.Background}"
        Foreground="{DynamicResource App.Foreground}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- navigation -->
            <Border Grid.Column="0" Background="{DynamicResource App.Surface}"
                    BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="16,18,16,10">
                        <TextBlock Text="Local AI Model Manager" FontWeight="Bold" FontSize="14"
                                   Foreground="{DynamicResource App.Foreground}" TextWrapping="Wrap" />
                        <TextBlock Text="本地模型生命周期管理与 OpenAI 兼容网关" FontSize="11" Margin="0,4,0,0"
                                   Foreground="{DynamicResource App.ForegroundMuted}" TextWrapping="Wrap" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Name}" FontSize="11" Margin="18,6,0,4"
                                                   Foreground="{DynamicResource App.ForegroundMuted}" />
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button HorizontalContentAlignment="Stretch"
                                                            Margin="8,1" Padding="10,7" BorderThickness="0"
                                                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                                <Setter Property="MinWidth" Value="0" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource App.Selection}" />
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="24" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Glyph}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Title}" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Badge}"
                                                                       Foreground="{DynamicResource App.ForegroundMuted}"
                                                                       FontSize="11" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- page host -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentView}" />
        </Grid>

        <!-- status bar -->
        <Border Grid.Row="1" Background="{DynamicResource App.Surface}"
                BorderBrush="{DynamicResource App.Border}" BorderThickness="0,1,0,0" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,18,0">
                    <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource Status.Error}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GatewayText}" Value="网关已停止">
                                        <Setter Property="Fill" Value="{DynamicResource Status.Error}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding GatewayText}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding LoadedModelsText}" FontSize="12" Margin="0,0,18,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource App.ForegroundMuted}" />
                <TextBlock Grid.Column="2" Text="{Binding EngineText}" FontSize="12" Margin="0,0,18,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource App.ForegroundMuted}" />

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusTimestampText}" FontSize="11" VerticalAlignment="Center"
                               Margin="0,0,12,0" Foreground="{DynamicResource App.ForegroundMuted}" />
                    <Button Content="重启网关" FontSize="11" Padding="8,3" Command="{Binding RestartGatewayCommand}" />
                    <Button Content="配置目录" FontSize="11" Padding="8,3" Margin="0"
                            Command="{Binding OpenConfigFolderCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
